	partition 'Store Lookup' = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(SourceFolder & "Store Lookup.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.None]),
				    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    ChangedTypes = Table.TransformColumnTypes(PromotedHeaders, {
				        {"store_id", Int64.Type},
				        {"store_type", type text},
				        {"store_square_feet", Int64.Type},
				        {"store_address", type text},
				        {"store_city", type text},
				        {"store_state_province", type text},
				        {"store_postal_code", type text},
				        {"store_longitude", type number},
				        {"store_latitude", type number},
				        {"manager", type text},
				        {"Neighorhood", type text}
				    })
				in
				    ChangedTypes

	annotation PBI_ResultType = Table

