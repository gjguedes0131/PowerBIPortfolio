{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.3.0/schema.json",
  "name": "BarByStore",
  "position": {
    "x": 20,
    "y": 190,
    "z": 0,
    "width": 600,
    "height": 480,
    "tabOrder": 3
  },
  "visual": {
    "visualType": "clusteredColumnChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": { "SourceRef": { "Entity": "Store Lookup" } },
                  "Property": "store_city"
                }
              },
              "queryRef": "Store Lookup.store_city",
              "nativeQueryRef": "store_city"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": { "SourceRef": { "Entity": "_Measures" } },
                  "Property": "Total Revenue"
                }
              },
              "queryRef": "_Measures.Total Revenue",
              "nativeQueryRef": "Total Revenue"
            }
          ]
        }
      }
    },
    "objects": {
      "dataPoint": [
        {
          "properties": {
            "fill": {
              "solid": {
                "color": {
                  "expr": { "Literal": { "Value": "'#6F4E37'" } }
                }
              }
            }
          }
        }
      ]
    }
  }
}
