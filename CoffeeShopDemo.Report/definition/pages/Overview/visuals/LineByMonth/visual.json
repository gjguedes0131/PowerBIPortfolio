{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.3.0/schema.json",
  "name": "LineByMonth",
  "position": {
    "x": 640,
    "y": 190,
    "z": 0,
    "width": 620,
    "height": 480,
    "tabOrder": 4
  },
  "visual": {
    "visualType": "lineChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": { "SourceRef": { "Entity": "Calendar" } },
                  "Property": "Transaction_Date"
                }
              },
              "queryRef": "Calendar.Transaction_Date",
              "nativeQueryRef": "Transaction_Date"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": { "SourceRef": { "Entity": "_Measures" } },
                  "Property": "Total Revenue"
                }
              },
              "queryRef": "_Measures.Total Revenue",
              "nativeQueryRef": "Total Revenue"
            }
          ]
        }
      }
    },
    "objects": {
      "dataPoint": [
        {
          "properties": {
            "fill": {
              "solid": {
                "color": {
                  "expr": { "Literal": { "Value": "'#C8A165'" } }
                }
              }
            }
          }
        }
      ]
    }
  }
}
