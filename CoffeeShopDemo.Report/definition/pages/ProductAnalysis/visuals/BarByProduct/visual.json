{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.3.0/schema.json",
  "name": "BarByProduct",
  "position": {
    "x": 20,
    "y": 20,
    "z": 0,
    "width": 1240,
    "height": 660,
    "tabOrder": 0
  },
  "visual": {
    "visualType": "barChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": { "SourceRef": { "Entity": "Product Lookup" } },
                  "Property": "product"
                }
              },
              "queryRef": "Product Lookup.product",
              "nativeQueryRef": "product"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": { "SourceRef": { "Entity": "_Measures" } },
                  "Property": "Total Revenue"
                }
              },
              "queryRef": "_Measures.Total Revenue",
              "nativeQueryRef": "Total Revenue"
            }
          ]
        }
      }
    },
    "objects": {
      "dataPoint": [
        {
          "properties": {
            "fill": {
              "solid": {
                "color": {
                  "expr": { "Literal": { "Value": "'#3E2723'" } }
                }
              }
            }
          }
        }
      ]
    }
  }
}
