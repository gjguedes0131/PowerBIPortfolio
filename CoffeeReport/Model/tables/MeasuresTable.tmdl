table MeasuresTable

	measure Cost =
			
			SUMX(
			    'Sales by Store',
			    'Sales by Store'[quantity_sold]*
			    RELATED(
			        'Product Lookup'[current_cost]
			    )
			)
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		displayFolder: Tips & Best Practices

	measure CustomerSales =
			
			Var sales = SUMX(
			    'Sales by Store',
			    'Sales by Store'[quantity_sold]*'Sales by Store'[unit_price]
			)
			Return
			sales
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Tips & Best Practices

	measure AllStoresTotalSalesExcludingStore5 =
			
			Var ExcludedStore = 5
			RETURN
			CALCULATE(
			    [CustomerSales],
			    ALLEXCEPT('Store Lookup'
			        ,'Store Lookup'[store_id])
			            ,'Store Lookup'[store_id] <> ExcludedStore
			)
		displayFolder: TransactionMeasures

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure TotaMTDSales = TOTALMTD([CustomerSales],'Calendar'[Transaction_Date])
		displayFolder: TransactionMeasures

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure SevenDayRollingAvg = ```
			
			Var Rolling7DayAvg = IF(
			    COUNTROWS(
			        DATESINPERIOD(
			            'Calendar'[Transaction_Date],
			            LASTDATE('Calendar'[Transaction_Date]), 
			            -7, 
			            DAY
			        )
			    ) = 7,
			    AVERAGEX(
			        DATESINPERIOD(
			            'Calendar'[Transaction_Date],
			            LASTDATE('Calendar'[Transaction_Date]),
			            -7, 
			            DAY
			        ), 
			        [CustomerSales])
			        ,"N/A")
			RETURN
			SWITCH(TRUE(),
			    Rolling7DayAvg ="N\A","N\A",
			    Rolling7DayAvg >= 0, FORMAT(Rolling7DayAvg,"$#,##0.00"))
			
			```
		displayFolder: TransactionMeasures

	measure TopSellingProduct = ```
			
			// Define the current year based on the selected value in the 'Calendar' table
			VAR CurrentYear = SELECTEDVALUE('Calendar'[Year_ID])
			
			// Calculate the maximum sales value (quantity_sold * unit_price) for the current year
			VAR TopProductSales = 
			    CALCULATE(
			        MAXX(
			            'Sales by Store', 
			            'Sales by Store'[quantity_sold] * 'Sales by Store'[unit_price]
			        ),
			        YEAR('Sales by Store'[transaction_date]) = CurrentYear
			    )
			
			// Filter the 'Sales by Store' table to include only rows with the maximum sales value for the current year
			VAR ProductsWithTopSales = 
			    FILTER(
			        'Sales by Store', 
			        YEAR('Sales by Store'[transaction_date]) = CurrentYear && 
			        'Sales by Store'[quantity_sold] * 'Sales by Store'[unit_price] = TopProductSales
			    )
			
			// Concatenate the product names from the filtered table, separated by a comma and space
			VAR ProductNames = 
			    CONCATENATEX(
			        SUMMARIZE(
			            ProductsWithTopSales, 
			            'Product Lookup'[product]
			        ),
			        'Product Lookup'[product],
			        ", "
			    )
			
			// Count the number of distinct products with the maximum sales value
			VAR ProductCount = 
			    COUNTROWS(
			        SUMMARIZE(
			            ProductsWithTopSales, 
			            'Product Lookup'[product]
			        )
			    )
			
			// Return the concatenated product names if there are multiple products, otherwise return the single product name
			RETURN
			IF(
			    ProductCount > 1,
			    ProductNames,
			    FIRSTNONBLANK(
			        'Product Lookup'[product],
			        1
			    )
			)
			
			```
		displayFolder: TransactionMeasures

	measure Measure = ```
			
			
			```
		formatString: 0
		displayFolder: TransactionMeasures

	measure BottomSellingProduct = ```
			
			// Define the current year based on the selected value in the 'Calendar' table
			VAR CurrentYear = SELECTEDVALUE('Calendar'[Year_ID])
			
			// Calculate the minimum sales value (quantity_sold * unit_price) for the current year
			VAR TopProductSales = 
			    CALCULATE(
			        MINX(
			            'Sales by Store', 
			            'Sales by Store'[quantity_sold] * 'Sales by Store'[unit_price]
			        ),
			        YEAR('Sales by Store'[transaction_date]) = CurrentYear
			    )
			
			// Filter the 'Sales by Store' table to include only rows with the minimum sales value for the current year
			VAR ProductsWithTopSales = 
			    FILTER(
			        'Sales by Store', 
			        YEAR('Sales by Store'[transaction_date]) = CurrentYear && 
			        'Sales by Store'[quantity_sold] * 'Sales by Store'[unit_price] = TopProductSales
			    )
			
			// Concatenate the product names from the filtered table, separated by a comma and space
			VAR ProductNames = 
			    CONCATENATEX(
			        SUMMARIZE(
			            ProductsWithTopSales, 
			            'Product Lookup'[product]
			        ),
			        'Product Lookup'[product],
			        ", "
			    )
			
			// Count the number of distinct products with the minimum sales value
			VAR ProductCount = 
			    COUNTROWS(
			        SUMMARIZE(
			            ProductsWithTopSales, 
			            'Product Lookup'[product]
			        )
			    )
			
			// Return the concatenated product names if there are multiple products, otherwise return the single product name
			RETURN
			IF(
			    ProductCount > 1,
			    "Multiple Products",
			    FIRSTNONBLANK(
			        'Product Lookup'[product],
			        1
			    )
			)
			
			```
		displayFolder: TransactionMeasures

	measure MinTransactionForDay = ```
			
			Var CurrentDate = MAX('Calendar'[Transaction_Date])
			RETURN
			   CALCULATE(
			        MINX(
			            'Sales by Store', 
			            'Sales by Store'[quantity_sold] * 'Sales by Store'[unit_price]
			        ),
			        'Sales by Store'[transaction_date] = CurrentDate
			    )
			```
		displayFolder: TransactionMeasures

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Transactions = COUNTROWS('Sales by Store')
		formatString: 0
		displayFolder: TransactionMeasures

	measure CustomerSalesFormat = ```
			
			// Define the variable 'Sales' to hold the value of [CustomerSales]
			VAR Sales = [CustomerSales]
			RETURN
			    SWITCH (
			        TRUE (),
			        // If Sales is 0 or BLANK, return "N/A"
			        Sales IN { 0, BLANK () }, "N/A",
			        // If Sales is greater than 0 and less than 1,000, format as "$##0.00"
			        Sales > 0
			            && Sales < 1000, FORMAT ( Sales, "$##0.00;($##0.00)" ),
			        // If Sales is between 1,000 and 100,000, format as "$#,##0.00K"
			        Sales >= 1000
			            && Sales < 100000, FORMAT ( Sales / 1000, "$#,##0.00K;($#,##0.00K)" ),
			        // If Sales is between 100,000 and 1,000,000, format as "$###.0K"
			        Sales >= 100000
			            && Sales < 1000000, FORMAT ( Sales / 1000, "$###.0K;($###.0K)" ),
			        // If Sales is between 1,000,000 and 10,000,000, format as "$#,##0.0M"
			        Sales >= 1000000
			            && Sales < 10000000, FORMAT ( Sales / 1000000, "$#,##0.0M;($#,##0.0M)" ),
			        // If Sales is between 10,000,000 and 100,000,000, format as "$##.0M"
			        Sales >= 10000000
			            && Sales < 100000000, FORMAT ( Sales / 1000000, "$##.0M;($##.0M)" ),
			        // If Sales is 100,000,000 or more, format as "$###.0M"
			        Sales >= 100000000, FORMAT ( Sales / 1000000, "$###.0M;($###.0M)" )
			    )
			
			```
		displayFolder: TransactionMeasures

	measure Profit = [CustomerSales] - [Cost]
		displayFolder: Tips & Best Practices

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Start Inventory Cost' = ```
			
			Var sales = SUMX('Food Inventory',[Beginning Inventory]*Related('Product Lookup'[current_cost]))
			Return
			    SWITCH (
			        TRUE (),
			        // If Sales is 0 or BLANK, return "N/A"
			        Sales IN { 0, BLANK () }, "N/A",
			        // If Sales is greater than 0 and less than 1,000, format as "$##0.00"
			        Sales > 0
			            && Sales < 1000, FORMAT ( Sales, "$##0.00;($##0.00)" ),
			        // If Sales is between 1,000 and 100,000, format as "$#,##0.00K"
			        Sales >= 1000
			            && Sales < 100000, FORMAT ( Sales / 1000, "$#,##0.00K;($#,##0.00K)" ),
			        // If Sales is between 100,000 and 1,000,000, format as "$###.0K"
			        Sales >= 100000
			            && Sales < 1000000, FORMAT ( Sales / 1000, "$###.0K;($###.0K)" ),
			        // If Sales is between 1,000,000 and 10,000,000, format as "$#,##0.0M"
			        Sales >= 1000000
			            && Sales < 10000000, FORMAT ( Sales / 1000000, "$#,##0.0M;($#,##0.0M)" ),
			        // If Sales is between 10,000,000 and 100,000,000, format as "$##.0M"
			        Sales >= 10000000
			            && Sales < 100000000, FORMAT ( Sales / 1000000, "$##.0M;($##.0M)" ),
			        // If Sales is 100,000,000 or more, format as "$###.0M"
			        Sales >= 100000000, FORMAT ( Sales / 1000000, "$###.0M;($###.0M)" )
			    )
			
			```
		displayFolder: Tips & Best Practices

	measure 'Beginning Inventory' = SUM('Food Inventory'[quantity_start_of_day])
		formatString: #,0
		displayFolder: Tips & Best Practices

	measure 'Baked Quantity Sold' = SUM('Food Inventory'[quantity_sold])
		formatString: #,0
		displayFolder: Tips & Best Practices

	measure 'Quantity Sold' = sum('Sales by Store'[quantity_sold])
		displayFolder: Tips & Best Practices

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Ending Inventory' = [Beginning Inventory] - [Baked Quantity Sold]
		formatString: #,0
		displayFolder: Tips & Best Practices

	measure 'Ending Inventory Cost' = ```
			
			Var sales = SUMX('Food Inventory',[Ending Inventory]*Related('Product Lookup'[current_cost]))
			Return
			    SWITCH (
			        TRUE (),
			        // If Sales is 0 or BLANK, return "N/A"
			        Sales IN { 0, BLANK () }, "N/A",
			        // If Sales is greater than 0 and less than 1,000, format as "$##0.00"
			        Sales > 0
			            && Sales < 1000, FORMAT ( Sales, "$##0.00;($##0.00)" ),
			        // If Sales is between 1,000 and 100,000, format as "$#,##0.00K"
			        Sales >= 1000
			            && Sales < 100000, FORMAT ( Sales / 1000, "$#,##0.00K;($#,##0.00K)" ),
			        // If Sales is between 100,000 and 1,000,000, format as "$###.0K"
			        Sales >= 100000
			            && Sales < 1000000, FORMAT ( Sales / 1000, "$###.0K;($###.0K)" ),
			        // If Sales is between 1,000,000 and 10,000,000, format as "$#,##0.0M"
			        Sales >= 1000000
			            && Sales < 10000000, FORMAT ( Sales / 1000000, "$#,##0.0M;($#,##0.0M)" ),
			        // If Sales is between 10,000,000 and 100,000,000, format as "$##.0M"
			        Sales >= 10000000
			            && Sales < 100000000, FORMAT ( Sales / 1000000, "$##.0M;($##.0M)" ),
			        // If Sales is 100,000,000 or more, format as "$###.0M"
			        Sales >= 100000000, FORMAT ( Sales / 1000000, "$###.0M;($###.0M)" )
			    )
			
			```
		displayFolder: Tips & Best Practices

	measure SelectedProductTitle = ```
			
			// Define a variable to check if the 'product' column is filtered
			VAR FilterByProduct = ISFILTERED('Product Lookup'[product])
			
			// Define a variable to get the selected product value
			VAR SelectedProduct = SELECTEDVALUE('Product Lookup'[product])
			
			RETURN
			    // Use IF and SWITCH to return the appropriate title based on whether the product is filtered
			    IF (
			        FilterByProduct = FALSE(),
			        "Total Daily Sales",
			        IF (
			            COUNT('Product Lookup'[product]) > 1,
			            "Multiple Products - Daily Sales",
			            SWITCH (
			                TRUE(),
			                FilterByProduct = TRUE(), SelectedProduct & " - Daily Sales",
			                "Daily Sales"
			            )
			        )
			    )
			
			```

	measure TransactionDate =
			
			Var TransactionDate = Format(MAX('Calendar'[Transaction_Date]),"MM/DD/YYYY")
			Return
			 "Top 10 Product Sales: "& TransactionDate

	measure TransactionYear =
			
			Var TransactionYear = Format(MAX('Calendar'[Transaction_Date]),"YYYY")
			Return  "Top 10 Products Sales by Store : "& TransactionYear

	measure 'Sales % +/-' = ```
			
			VAR CurrentYear = SELECTEDVALUE('Calendar'[Year_ID])  // Get the selected year from the Calendar table
			VAR PriorYear = CurrentYear - 1  // Calculate the prior year
			VAR CurrentYearSales = CALCULATE(
			    [CustomerSales], 
			    ALLSELECTED('Calendar'), 
			    'Calendar'[Year_ID] = CurrentYear
			)  // Calculate sales for the current year
			VAR PriorYearSales = CALCULATE(
			    [CustomerSales], 
			    ALLSELECTED('Calendar'), 
			    'Calendar'[Year_ID] = PriorYear
			)  // Calculate sales for the prior year
			RETURN
			    DIVIDE(
			        (CurrentYearSales - PriorYearSales), 
			        PriorYearSales, 
			        0
			    )  // Calculate the percentage change in sales from the prior year to the current year
			
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: TransactionMeasures

	measure 30DayRollingAvg = ```
			
			Var Rolling30DayAvg = IF(
			    COUNTROWS(
			        DATESINPERIOD(
			            'Calendar'[Transaction_Date],
			            LASTDATE('Calendar'[Transaction_Date]), 
			            -30, 
			            DAY
			        )
			    ) = 30,
			    AVERAGEX(
			        DATESINPERIOD(
			            'Calendar'[Transaction_Date],
			            LASTDATE('Calendar'[Transaction_Date]),
			            -30, 
			            DAY
			        ), 
			        [CustomerSales])
			        ,"N/A")
			RETURN
			SWITCH(TRUE(),
			    Rolling30DayAvg ="N\A","N\A",
			    Rolling30DayAvg >= 0, FORMAT(Rolling30DayAvg,"$#,##0.00"))
			
			```
		displayFolder: TransactionMeasures

