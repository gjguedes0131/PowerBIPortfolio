	measure 7DTooltipMessage = ```
			
			VAR Productv = ISFILTERED('Product Lookup'[product])
			VAR SelectedProductv = SELECTEDVALUE('Product Lookup'[product])
			VAR SelectedDatev = SELECTEDVALUE('Calendar'[Transaction_Date])
			VAR Previous7DaySAvgv = 
			    CALCULATE(
			        [SevenDayRollingAvg],
			        DATEADD('Calendar'[Transaction_Date], -7, DAY)
			    )
			VAR Sales = 
			    DIVIDE([SevenDayRollingAvg] - Previous7DaySAvgv, Previous7DaySAvgv, 0) 
			VAR SalesFormat = 
			    SWITCH(
			        TRUE(),
			        Sales < 0, "< 0.00%",
			        Sales = 0, "0.00%",
			        Sales > 0 && Sales < 999, FORMAT(Sales, "##0.00%"),
			        Sales > 999, FORMAT(Sales, "#,##0.00%")
			    )
			VAR UpDown = 
			    SWITCH(
			        TRUE(),
			        Sales < 0, "Down",
			        Sales = 0, "No Change",
			        Sales > 0, "Up"
			    )
			RETURN
			    IF(
			        Productv && COUNT('Product Lookup'[product]) = 1, "7D"&" : "&
			        SelectedProductv & " - Avg Store Customer Sales " & UpDown & " " & "( "&SalesFormat&" )",
			        IF(
			            Productv && COUNT('Product Lookup'[product]) > 1, "7D"&" : "&
			            "Multiple Products - Avg Store Customer Sales " & UpDown & " " & "( "&SalesFormat&" )", "7D"&" : "&
			            "Avg Customer Store Sales " & UpDown & " " & "( "&SalesFormat&" )"
			        )
			    )
			
			```

	measure 1MTooltipMessage = ```
			
			VAR Productv = ISFILTERED('Product Lookup'[product])
			VAR SelectedProductv = SELECTEDVALUE('Product Lookup'[product])
			VAR SelectedDatev = SELECTEDVALUE('Calendar'[Transaction_Date])
			VAR Previous1MAvgv = 
			    CALCULATE( [30DayRollingAvg]
			        ,
			        DATEADD('Calendar'[Transaction_Date], -1, MONTH)
			    )
			VAR Sales = 
			    DIVIDE([30DayRollingAvg] - Previous1MAvgv, Previous1MAvgv, 0)
			VAR SalesFormat = 
			    SWITCH(
			        TRUE(),
			        Sales < 0, "< 0.00%",
			        Sales = 0, "0.00%",
			        Sales > 0 && Sales < 999, FORMAT(Sales, "##0.00%"),
			        Sales >= 999,  FORMAT(Sales, "#,##0.00%")
			    )
			VAR UpDown = 
			    SWITCH(
			        TRUE(),
			        Sales < 0, "Down",
			        Sales = 0, "No Change",
			        Sales > 0, "Up"
			    )
			RETURN
			    IF(
			        Productv && COUNT('Product Lookup'[product]) = 1, "1M"&" : "&
			        SelectedProductv & " - Avg Store Customer Sales " & UpDown & " " & "( "&SalesFormat&" )",
			        IF(
			            Productv && COUNT('Product Lookup'[product]) > 1, "1M"&" : "&
			            "Multiple Products - Avg Store Customer Sales " & UpDown & " " & "( "&SalesFormat&" )","1M"&" : "&
			            "Avg Customer Store Sales " & UpDown & " " & "( "&SalesFormat&" )"
			        )
			    )
			
			```

