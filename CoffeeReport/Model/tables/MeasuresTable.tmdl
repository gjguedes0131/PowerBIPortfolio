	measure StoreQuantitySoldFormat = ```
			
			Var Quantity = [Quantity Sold]
			Return
			    SWITCH (
			
			        TRUE (),
			
			        Quantity IN { 0, BLANK( ) }, "N/A",
			
			        Quantity > 0 &&  Quantity < 1000, FORMAT( Quantity, "$##0.00;($##0.00)"),
			
			        Quantity >= 1000 && Quantity < 100000, FORMAT( Quantity, "$##,000.00;($##,000.00)" ),
			
			        Quantity >= 100000 && Quantity < 1000000, FORMAT( Quantity, "$###,000.00;($###,000.00)" ),
			
			        Quantity >= 1000000 && Quantity < 10000000, FORMAT( Quantity, "$#,###,000.00;($#,###,000.00)" ),
			
			        Quantity >= 10000000 && Quantity < 100000000, FORMAT( Quantity, "$##,###,000.00;($##,###,000.00)" ),
			
			        Quantity >= 100000000,FORMAT( Quantity, "$###,###,000.00;($###,###,000.00)" )
			
			    )
			
			 
			
			```
		displayFolder: Tips & Best Practices

	measure 7DSelectedProductTitle = ```
			
			// Define a variable to check if the 'product' column is filtered
			VAR FilterByProduct = ISFILTERED('Product Lookup'[product])
			
			// Define a variable to get the selected product value
			VAR SelectedProduct = SELECTEDVALUE('Product Lookup'[product])
			
			RETURN
			    // Use IF and SWITCH to return the appropriate title based on whether the product is filtered
			    IF (
			        FilterByProduct = FALSE(),
			        "7D Sales Avg",
			        IF (
			            COUNT('Product Lookup'[product]) > 1,
			            "Multiple Products - 7D Sales Avg",
			            SWITCH (
			                TRUE(),
			                FilterByProduct = TRUE(), SelectedProduct & " - 7D Sales Avg",
			                ""
			            )
			        )
			    )
			
			```

