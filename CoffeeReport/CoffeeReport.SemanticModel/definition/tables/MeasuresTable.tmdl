table MeasuresTable
	lineageTag: 5034d261-5ac4-4dd9-9a1a-d36abef4e25c

	measure Cost =
			
			SUMX(
			    'Sales by Store',
			    'Sales by Store'[quantity_sold]*
			    RELATED(
			        'Product Lookup'[current_cost]
			    )
			)
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		displayFolder: Tips & Best Practices
		lineageTag: 9a6302d2-f08f-43c9-863a-81e796582ba8

	measure CustomerSales =
			
			Var sales = SUMX(
			    'Sales by Store',
			    'Sales by Store'[quantity_sold]*'Sales by Store'[unit_price]
			)
			Return
			sales
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Tips & Best Practices
		lineageTag: 3e3c6317-0d2b-4f1b-b309-eb8b3d4b0e5f

	measure AllStoresTotalSalesExcludingStore5 =
			
			Var ExcludedStore = 5
			RETURN
			CALCULATE(
			    [CustomerSales],
			    ALLEXCEPT('Store Lookup'
			        ,'Store Lookup'[store_id])
			            ,'Store Lookup'[store_id] <> ExcludedStore
			)
		displayFolder: TransactionMeasures
		lineageTag: f50b0b2a-7666-45de-8dae-aa4110f78379

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure TotaMTDSales = TOTALMTD([CustomerSales],'Calendar'[Transaction_Date])
		displayFolder: TransactionMeasures
		lineageTag: 4df8888b-b110-4514-a6d3-f528a3e13a10

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure SevenDayRollingAvg = ```
			
			Var Rolling7DayAvg = IF(
			    COUNTROWS(
			        DATESINPERIOD(
			            'Calendar'[Transaction_Date],
			            LASTDATE('Calendar'[Transaction_Date]), 
			            -7, 
			            DAY
			        )
			    ) = 7,
			    AVERAGEX(
			        DATESINPERIOD(
			            'Calendar'[Transaction_Date],
			            LASTDATE('Calendar'[Transaction_Date]),
			            -7, 
			            DAY
			        ), 
			        [CustomerSales])
			        ,"N/A")
			RETURN
			SWITCH(TRUE(),
			    Rolling7DayAvg ="N\A","N\A",
			    Rolling7DayAvg >= 0, FORMAT(Rolling7DayAvg,"$#,##0.00"))
			
			```
		displayFolder: TransactionMeasures
		lineageTag: 4b802d3f-6bf3-4f01-8231-05e29b30588c

	measure TopSellingProduct = ```
			
			// Define the current year based on the selected value in the 'Calendar' table
			VAR CurrentYear = SELECTEDVALUE('Calendar'[Year_ID])
			
			// Calculate the maximum sales value (quantity_sold * unit_price) for the current year
			VAR TopProductSales = 
			    CALCULATE(
			        MAXX(
			            'Sales by Store', 
			            'Sales by Store'[quantity_sold] * 'Sales by Store'[unit_price]
			        ),
			        YEAR('Sales by Store'[transaction_date]) = CurrentYear
			    )
			
			// Filter the 'Sales by Store' table to include only rows with the maximum sales value for the current year
			VAR ProductsWithTopSales = 
			    FILTER(
			        'Sales by Store', 
			        YEAR('Sales by Store'[transaction_date]) = CurrentYear && 
			        'Sales by Store'[quantity_sold] * 'Sales by Store'[unit_price] = TopProductSales
			    )
			
			// Concatenate the product names from the filtered table, separated by a comma and space
			VAR ProductNames = 
			    CONCATENATEX(
			        SUMMARIZE(
			            ProductsWithTopSales, 
			            'Product Lookup'[product]
			        ),
			        'Product Lookup'[product],
			        ", "
			    )
			
			// Count the number of distinct products with the maximum sales value
			VAR ProductCount = 
			    COUNTROWS(
			        SUMMARIZE(
			            ProductsWithTopSales, 
			            'Product Lookup'[product]
			        )
			    )
			
			// Return the concatenated product names if there are multiple products, otherwise return the single product name
			RETURN
			IF(
			    ProductCount > 1,
			    ProductNames,
			    FIRSTNONBLANK(
			        'Product Lookup'[product],
			        1
			    )
			)
			
			```
		displayFolder: TransactionMeasures
		lineageTag: 3685f68a-32b6-471d-b30c-82e8af27b0a7

