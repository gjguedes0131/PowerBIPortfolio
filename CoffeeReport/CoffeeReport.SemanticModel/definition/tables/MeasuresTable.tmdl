	measure BottomSellingProduct = ```
			
			// Define the current year based on the selected value in the 'Calendar' table
			VAR CurrentYear = SELECTEDVALUE('Calendar'[Year_ID])
			
			// Calculate the minimum sales value (quantity_sold * unit_price) for the current year
			VAR TopProductSales = 
			    CALCULATE(
			        MINX(
			            'Sales by Store', 
			            'Sales by Store'[quantity_sold] * 'Sales by Store'[unit_price]
			        ),
			        YEAR('Sales by Store'[transaction_date]) = CurrentYear
			    )
			
			// Filter the 'Sales by Store' table to include only rows with the minimum sales value for the current year
			VAR ProductsWithTopSales = 
			    FILTER(
			        'Sales by Store', 
			        YEAR('Sales by Store'[transaction_date]) = CurrentYear && 
			        'Sales by Store'[quantity_sold] * 'Sales by Store'[unit_price] = TopProductSales
			    )
			
			// Concatenate the product names from the filtered table, separated by a comma and space
			VAR ProductNames = 
			    CONCATENATEX(
			        SUMMARIZE(
			            ProductsWithTopSales, 
			            'Product Lookup'[product]
			        ),
			        'Product Lookup'[product],
			        ", "
			    )
			
			// Count the number of distinct products with the minimum sales value
			VAR ProductCount = 
			    COUNTROWS(
			        SUMMARIZE(
			            ProductsWithTopSales, 
			            'Product Lookup'[product]
			        )
			    )
			
			// Return the concatenated product names if there are multiple products, otherwise return the single product name
			RETURN
			IF(
			    ProductCount > 1,
			    "Multiple Products",
			    FIRSTNONBLANK(
			        'Product Lookup'[product],
			        1
			    )
			)
			
			```
		displayFolder: TransactionMeasures
		lineageTag: 09f2ed9f-5ac6-4a5d-8f49-34b85dedc22c

