			        TRUE(),
			        Sales < 0, "Down",
			        Sales = 0, "No Change",
			        Sales > 0, "Up"
			    )
			RETURN
			    IF(
			        Productv && COUNT('Product Lookup'[product]) = 1, "3M"&" : "&
			        SelectedProductv & " - Avg Store Customer Sales " & UpDown & " " & "( "&SalesFormat&" )",
			        IF(
			            Productv && COUNT('Product Lookup'[product]) > 1, "3M"&" : "&
			            "Multiple Products - Avg Store Customer Sales " & UpDown & " " & "( "&SalesFormat&" )",  "3M"&" : "&
			            "Avg Customer Store Sales " & UpDown & " " & "( "&SalesFormat&" )"
			        )
			    )
			
			```
		lineageTag: e7fc1213-2285-4e3a-b40a-6dff4e702d0b

	measure QuantityStartofdayInventory = SUM('Food Inventory'[quantity_start_of_day])
		formatString: 0
		displayFolder: Tips & Best Practices
		lineageTag: 4deb1698-6212-4b55-ac44-09ae94e9e293

	measure '% of Inventory sold to Overall Production' = 1- ([Ending Inventory]/[QuantityStartofdayInventory])
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Tips & Best Practices
		lineageTag: 1399b915-d634-4289-835a-7431d0d5b2f8

	measure ColorPallete = ```
			
			Var  BeginingInventoryV = [Beginning Inventory]
			Var SoldInventoryV = [Baked Quantity Sold]
			Var SoldInventoryPercentageV = soldInventoryV/BeginingInventoryV
			Return
			    SWITCH(TRUE(),SoldInventoryPercentageV >= .2, "#6B8E23",
			    SoldInventoryPercentageV  >= .1 && SoldInventoryPercentageV < .2 , "#DEA96B",
			    SoldInventoryPercentageV  < .1, "#CD5C5C","#D3D3D3")
			
			```
		lineageTag: 98de7958-ead1-4de0-96b1-3b571b1de74f

	measure InventoryTooltipMessage = ```
			
			VAR Productv = ISFILTERED('Product Lookup'[product])
			Var SelectedProductv = SELECTEDVALUE('Product Lookup'[product])
			VAR SelectedDatev = [TransactionDate]
			Var PercentofInventoryV = Round(ABS([% of Inventory sold to Overall Production]),2)*100&"%"
			VAR StartofInventory = FORMAT([QuantityStartofdayInventory],"##,##0")
			
			Return
			SWITCH(TRUE(), Productv = TRUE() && COUNT('Product Lookup'[product]) = 1,
			    SelectedProductv& ": "&"
			    Start of Inventory "& StartofInventory &"."& " Percent of Inventory Remaining"&" : "& PercentofInventoryV,
			    Productv = FALSE(),"
			    Start of Inventory : "& StartofInventory &". "& " Percent of Inventory Remaining"&" : "& PercentofInventoryV)
			    
			
			
			```
		lineageTag: 80416dc1-2d3c-44f4-9c1e-6826bacb7205

