	measure StoreQuantitySoldFormat = ```
			
			Var Quantity = [Quantity Sold]
			Return
			    SWITCH (
			
			        TRUE (),
			
			        Quantity IN { 0, BLANK( ) }, "N/A",
			
			        Quantity > 0 &&  Quantity < 1000, FORMAT( Quantity, "$##0.00;($##0.00)"),
			
			        Quantity >= 1000 && Quantity < 100000, FORMAT( Quantity, "$##,000.00;($##,000.00)" ),
			
			        Quantity >= 100000 && Quantity < 1000000, FORMAT( Quantity, "$###,000.00;($###,000.00)" ),
			
			        Quantity >= 1000000 && Quantity < 10000000, FORMAT( Quantity, "$#,###,000.00;($#,###,000.00)" ),
			
			        Quantity >= 10000000 && Quantity < 100000000, FORMAT( Quantity, "$##,###,000.00;($##,###,000.00)" ),
			
			        Quantity >= 100000000,FORMAT( Quantity, "$###,###,000.00;($###,###,000.00)" )
			
			    )
			
			 
			
			```
