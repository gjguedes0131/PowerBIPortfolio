	measure 'Sales % +/-' = ```
			
			VAR CurrentYear = SELECTEDVALUE('Calendar'[Year_ID])  // Get the selected year from the Calendar table
			VAR PriorYear = CurrentYear - 1  // Calculate the prior year
			VAR CurrentYearSales = CALCULATE(
			    [CustomerSales], 
			    ALLSELECTED('Calendar'), 
			    'Calendar'[Year_ID] = CurrentYear
			)  // Calculate sales for the current year
			VAR PriorYearSales = CALCULATE(
			    [CustomerSales], 
			    ALLSELECTED('Calendar'), 
			    'Calendar'[Year_ID] = PriorYear
			)  // Calculate sales for the prior year
			RETURN
			    DIVIDE(
			        (CurrentYearSales - PriorYearSales), 
			        PriorYearSales, 
			        0
			    )  // Calculate the percentage change in sales from the prior year to the current year
			
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: TransactionMeasures
		lineageTag: 67502650-ce29-4a4a-9ee2-d0f13870a585

