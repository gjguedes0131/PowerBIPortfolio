	measure CustomerSalesFormat = ```
			
			// Define the variable 'Sales' to hold the value of [CustomerSales]
			VAR Sales = [CustomerSales]
			RETURN
			    SWITCH (
			        TRUE (),
			        // If Sales is 0 or BLANK, return "N/A"
			        Sales IN { 0, BLANK () }, "N/A",
			        // If Sales is greater than 0 and less than 1,000, format as "$##0.00"
			        Sales > 0
			            && Sales < 1000, FORMAT ( Sales, "$##0.00;($##0.00)" ),
			        // If Sales is between 1,000 and 100,000, format as "$#,##0.00K"
			        Sales >= 1000
			            && Sales < 100000, FORMAT ( Sales / 1000, "$#,##0.00K;($#,##0.00K)" ),
			        // If Sales is between 100,000 and 1,000,000, format as "$###.0K"
			        Sales >= 100000
			            && Sales < 1000000, FORMAT ( Sales / 1000, "$###.0K;($###.0K)" ),
			        // If Sales is between 1,000,000 and 10,000,000, format as "$#,##0.0M"
			        Sales >= 1000000
			            && Sales < 10000000, FORMAT ( Sales / 1000000, "$#,##0.0M;($#,##0.0M)" ),
			        // If Sales is between 10,000,000 and 100,000,000, format as "$##.0M"
			        Sales >= 10000000
			            && Sales < 100000000, FORMAT ( Sales / 1000000, "$##.0M;($##.0M)" ),
			        // If Sales is 100,000,000 or more, format as "$###.0M"
			        Sales >= 100000000, FORMAT ( Sales / 1000000, "$###.0M;($###.0M)" )
			    )
			
			```
		displayFolder: TransactionMeasures
		lineageTag: 1722bc69-fa82-497c-94df-2ac3cfc3827d

