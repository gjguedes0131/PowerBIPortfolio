table BasicTable
	lineageTag: 796b13b4-a5ab-4820-81fe-45de486d444f

	column CurrentYearSales
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 3813a430-be7a-49e2-a357-5629308e34c0
		summarizeBy: sum
		isNameInferred
		sourceColumn: [CurrentYearSales]

		annotation SummarizationSetBy = Automatic

	column PreviousSales
		lineageTag: b35b3f94-2337-44f5-bec5-4569c9b6f5df
		summarizeBy: sum
		isNameInferred
		sourceColumn: [PreviousSales]

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column product
		lineageTag: 18929249-ee6d-4bf8-aac7-b9d1a778f79b
		summarizeBy: none
		isNameInferred
		sourceColumn: Product Lookup[product]

		annotation SummarizationSetBy = Automatic

	column Year_ID
		formatString: 0
		lineageTag: e94a2c7f-df7a-4661-892b-5165e0e14598
		summarizeBy: count
		isNameInferred
		sourceColumn: Calendar[Year_ID]

		annotation SummarizationSetBy = Automatic

	partition BasicTable = calculated
		mode: import
		source = ```
				
				VAR Vrelation =
				    FILTER (
				        SUMMARIZECOLUMNS (
				            'Product Lookup'[product],  // Group by product
				            'Calendar'[Year_ID],        // Group by year
				            "CurrentYearSales", ROUND ( [CustomerSales], 0 )  // Calculate and round current year sales
				        ),
				        'Product Lookup'[product] <> ""  // Filter out blank products
				    )
				RETURN
				    ADDCOLUMNS (
				        Vrelation,
				        "PreviousSales",
				            SELECTCOLUMNS (
				                OFFSET (
				                    -1,  // Offset by one row back
				                    Vrelation,
				                    ORDERBY ( 'Product Lookup'[product], ASC, 'Calendar'[Year_ID], ASC ),  // Order by product and year
				                    PARTITIONBY ( 'Product Lookup'[product] ),  // Partition by product
				                    MATCHBY ( 'Product Lookup'[product], 'Calendar'[Year_ID] )  // Match by product and year
				                ),
				                [CurrentYearSales]  // Select current year sales from the previous row
				            )
				    )
				
				
				```

	annotation PBI_Id = 79a20558462d4a8480eba9e3b543fe83

